# promo/youtube/.env の雛形。setup.sh がこれをコピーして .env を作ります。
# .env は .gitignore で除外しているので、コミットされることはありません。

# --- Google Cloud コンソールで作る OAuth クライアント（種類: デスクトップアプリ）---
# https://console.cloud.google.com/apis/credentials
# 先に「YouTube Data API v3」を有効にしておいてください。
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# --- node youtube/yt.mjs auth が自動で書き込みます。手で入れる必要はありません ---
YT_REFRESH_TOKEN=

# --- 投稿する内容 ---
# 動画ファイルの場所（リポジトリのルートからの相対パス、または絶対パス）
YT_VIDEO=promo/youtube/video/promo.mp4

# サムネイル画像（無ければ YouTube が自動生成します）
YT_THUMBNAIL=promo/youtube/thumbnail.png

# 公開設定: private（自分だけ） / unlisted（URL を知っている人だけ） / public（全体公開）
YT_PRIVACY=private

# 動画カテゴリ。20 = Gaming
YT_CATEGORY_ID=20
